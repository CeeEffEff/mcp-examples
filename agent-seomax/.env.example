# Taskmaster API Keys Configuration
# Copy this file to .env and fill in your API keys

# Required for main model (Claude)
ANTHROPIC_API_KEY=ANTHROPIC_API_KEY_REDACTED

# Required for research features
PERPLEXITY_API_KEY=your_perplexity_key_here

# Optional - only if using these providers
# OPENAI_API_KEY=your_openai_key_here
# GOOGLE_API_KEY=your_google_key_here
# MISTRAL_API_KEY=your_mistral_key_here
# XAI_API_KEY=your_xai_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here

# For MCP usage, these keys should also be added to the parent repo's
# .cline/mcp.json or ~/.config/cline/mcp.json in the taskmaster-ai-local server's env section

# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# GCP Project Configuration (for ingestion pipeline)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Monitoring and Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_CONSOLE=true
LOG_FILE=true
LOG_GCP=false
LOG_JSON=false

# Prometheus Metrics Configuration
METRICS_ENABLED=true
METRICS_NAMESPACE=gcp_pipeline
METRICS_PORT=8000

# Health Monitoring Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60

# Alert Configuration
ALERTS_ENABLED=true
ALERT_CHANNELS=log,console
ALERT_EMAIL_RECIPIENTS=
ALERT_WEBHOOK_URL=
