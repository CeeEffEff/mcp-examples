--- /dev/null
+++ b/src/seomax/implementations/aws_wif_authenticator.py
@@ -0,0 +1,83 @@
+import json
+from typing import Dict, Optional
+
+import boto3
+
+from botocore.auth import SigV4Auth
+from botocore.awsrequest import AWSRequest
+from botocore.credentials import Credentials
+
+from seomax.constants.constants import CONFIG
+from seomax.interfaces.authenticator import (
+    AuthenticatorInterface,
+    AuthenticationMechanism,
+    AuthorisedRequest,
+    AuthenticationException,
+)
+from seomax.cloud_logging.setup import logger
+
+
+class AWSWIFAuthenticator(AuthenticatorInterface):
+    def __init__(self, aws_role: str, aws_region: str):
+        super().__init__(AuthenticationMechanism.WIF)
+        self.aws_role = aws_role
+        self.aws_region = aws_region
+
+    # ------------------------------------------------------------------------------------------------
+    # Internal Methods.
+    # ------------------------------------------------------------------------------------------------
+
+    def __get_aws_credentials(self, token: str) -> Dict:
+        """Assume AWS role using Google token.
+
+        A trust relationship must exist between the service account email
+        and the target AWS role.
+
+        Args:
+            token (str): from the GCP environment.
+
+        Returns:
+            Dict: with the credentials from AWS.
+        """
+        logger.debug(f"Attempting AWS STS exchange with {token}")
+        response = boto3.client("sts").assume_role_with_web_identity(
+            RoleArn=self.aws_role, RoleSessionName="WIFSession", WebIdentityToken=token
+        )
+        return response["Credentials"]
+
+    # ------------------------------------------------------------------------------------------------
+    # Exposed Methods.
+    # ------------------------------------------------------------------------------------------------
+
+    def get_authorised_request(
+        self, method: str, url: str, data: Dict, headers: Dict, token: Optional[str] = None
+    ) -> AuthorisedRequest:
+        # Add necessary headers.
+        headers["Content-Type"] = "application/json"
+
+        logger.info(f"Getting authorised request against: {method} {url} {data} {headers}")
+        try:
+            # Get a set of credentials from AWS.
+            credentials = self.__get_aws_credentials(
+                self.get_impersonated_oauth_token(CONFIG.AWS_WIF_CONFIG.SHARED_SA_EMAIL)
+                if CONFIG.AWS_WIF_CONFIG.IMPERSONATE_FOR_AWS_WIF
+                else self.get_native_oauth_token()
+            )
+
+            # Prepare an AWS request.
+            aws_request = AWSRequest(method=method, url=url, data=json.dumps(data), headers=headers)
+
+            # Create credentials object for signature.
+            credentials_obj = Credentials(
+                access_key=credentials["AccessKeyId"],
+                secret_key=credentials["SecretAccessKey"],
+                token=credentials["SessionToken"],
+            )
+
+            # Sign the AWS request.
+            SigV4Auth(credentials_obj, "execute-api", self.aws_region).add_auth(aws_request)
+
+            return AuthorisedRequest(method=method, url=url, data=aws_request.body, headers=aws_request.headers)
+        except Exception as e:
+            logger.error(f"Exception ({e}) when attempting to get authentication from via AWS WIF.")
+            raise AuthenticationException() from e
