@@ -0,0 +1,119 @@
+from datetime import datetime
+import os
+import sys
+from typing import Any, Dict
+
+sys.path.append(os.path.abspath(".."))
+sys.path.append(os.path.abspath("../src"))
+sys.path.append(os.path.abspath("../src/seomax"))
+
+from seomax.models.database import Job  # noqa: E402
+
+
+# Define a helper function to convert inner values
+def convert_inner_value(field_mapping: Dict) -> Any:
+    field_types = list(field_mapping.keys())
+    if not field_types:
+        return None
+    field_type = field_types[0]
+    value = field_mapping[field_type]
+    if field_type == "mapValue":
+        return {k: convert_inner_value(v) for k, v in value.get("fields", {}).items()}
+    elif field_type == "arrayValue":
+        return [convert_inner_value(v) for v in value.get("values", [])]
+    elif field_type == "nullValue":
+        return None
+    elif field_type == "timestampValue":
+        try:
+            return datetime.fromisoformat(value)
+        except ValueError:
+            # Handle the case where the string does not match ISO format exactly
+            if "Z" in value:
+                value = value.replace("Z", "+00:00")  # Replace 'Z' with '+00:00' to indicate UTC
+            return datetime.strptime(value, "%Y-%m-%dT%H:%M:%S.%f%z")
+    elif field_type == "integerValue":
+        return int(value)
+    else:
+        return str(value)
+
+
+# Define a function to convert the dictionary to the Job model
+def dict_to_job(job_dict: Dict[str, Any]) -> Job:
+    intermediary_dict = {}
+
+    for field_name, field_mapping in job_dict.get("fields", {}).items():
+        intermediary_dict[field_name] = convert_inner_value(field_mapping)
+        print(f"{field_name}: {intermediary_dict[field_name]}")
+
+    return Job(**intermediary_dict)
+
+
+# Example usage
+job_data = {
+    "update": {
+        "name": "projects/prj-croud-dev-seomax/databases/seomax-fs--df0c755fa65b5cbf/documents/JOBS/L5JS8QRDPQECWYC3A3YZ",
+        "fields": {
+            "id": {"stringValue": "L5JS8QRDPQECWYC3A3YZ"},
+            "owner_name": {"nullValue": 0},
+            "start_ts": {"nullValue": 0},
+            "config": {"nullValue": 0},
+            "categorisation": {"arrayValue": {"values": []}},
+            "sample": {"arrayValue": {"values": []}},
+            "status_current": {
+                "mapValue": {
+                    "fields": {
+                        "updated_at": {"timestampValue": "2025-08-18T19:55:42.884441Z"},
+                        "status": {"integerValue": "7"},
+                        "message": {
+                            "stringValue": "[aasd] JobExpirationTask scheduled expiration 1970-01-01 00:00:00+00:00 "
+                            "triggered while job was [DRAFTING]"
+                        },
+                    }
+                }
+            },
+            "owner_id": {"nullValue": 0},
+            "job_origin": {"stringValue": "API"},
+            "created_at": {"timestampValue": "2025-08-18T19:43:08.964883Z"},
+            "client_id": {"nullValue": 0},
+            "expires_at": {"nullValue": 0},
+            "status_history": {
+                "arrayValue": {
+                    "values": [
+                        {
+                            "mapValue": {
+                                "fields": {
+                                    "updated_at": {"timestampValue": "2025-08-18T19:43:08.964937Z"},
+                                    "status": {"integerValue": "0"},
+                                    "message": {"nullValue": 0},
+                                }
+                            }
+                        },
+                        {
+                            "mapValue": {
+                                "fields": {
+                                    "updated_at": {"timestampValue": "2025-08-18T19:55:42.884441Z"},
+                                    "status": {"integerValue": "7"},
+                                    "message": {
+                                        "stringValue": "[aasd] JobExpirationTask scheduled expiration 1970-01-01 00:00:00+00:00"
+                                        " triggered while job was [DRAFTING]"
+                                    },
+                                }
+                            }
+                        },
+                    ]
+                }
+            },
+            "notified": {"booleanValue": False},
+            "updated_at": {"timestampValue": "2025-08-18T19:43:08.965497Z"},
+            "job_id": {"stringValue": "L5JS8QRDPQECWYC3A3YZ"},
+            "job_name": {"nullValue": 0},
+            "owner_last_name": {"nullValue": 0},
+            "client_name": {"nullValue": 0},
+        },
+    },
+    "updateTransforms": [],
+}
+
+# Convert the dictionary to a Job instance
+job_instance = dict_to_job(job_data["update"])
+print(Job)
