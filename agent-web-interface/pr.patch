+from seomax.implementations.job_metrics import JobMetricsUpdater
+from seomax.implementations.metric_client_interceptor import MetricClientInterceptor
+
+
+import grpc
+from google.api_core import gapic_v1
+from google.api_core.gapic_v1.client_info import DEFAULT_CLIENT_INFO
+from google.auth import credentials as ga_credentials
+from google.cloud.firestore_v1.services.firestore.transports.grpc import FirestoreGrpcTransport
+
+
+from typing import Callable, Optional, Sequence, Tuple, Union
+
+
+class MetricInterceptFirestoreGrpcTransport(FirestoreGrpcTransport):
+    def __init__(
+        self,
+        metrics_updater: JobMetricsUpdater,
+        *,
+        host: str = "firestore.googleapis.com",
+        credentials: Optional[ga_credentials.Credentials] = None,
+        credentials_file: Optional[str] = None,
+        scopes: Optional[Sequence[str]] = None,
+        channel: Optional[Union[grpc.Channel, Callable[..., grpc.Channel]]] = None,
+        api_mtls_endpoint: Optional[str] = None,
+        client_cert_source: Optional[Callable[[], Tuple[bytes, bytes]]] = None,
+        ssl_channel_credentials: Optional[grpc.ChannelCredentials] = None,
+        client_cert_source_for_mtls: Optional[Callable[[], Tuple[bytes, bytes]]] = None,
+        quota_project_id: Optional[str] = None,
+        client_info: gapic_v1.client_info.ClientInfo = DEFAULT_CLIENT_INFO,
+        always_use_jwt_access: Optional[bool] = False,
+        api_audience: Optional[str] = None,
+    ) -> None:
+        super().__init__(
+            host=host,
+            credentials=credentials,
+            credentials_file=credentials_file,
+            scopes=scopes,
+            channel=channel,
+            api_mtls_endpoint=api_mtls_endpoint,
+            client_cert_source=client_cert_source,
+            ssl_channel_credentials=ssl_channel_credentials,
+            client_cert_source_for_mtls=client_cert_source_for_mtls,
+            quota_project_id=quota_project_id,
+            client_info=client_info,
+            always_use_jwt_access=always_use_jwt_access,
+            api_audience=api_audience,
+        )
+
+        # TODO try use logging client interceptor again
+        # logging_interceptor = _LoggingClientInterceptor()
+        self._metrics_updater = metrics_updater
+        metric_interceptor = MetricClientInterceptor(self._metrics_updater)
+        self._interceptor = metric_interceptor
+        self._logged_channel = grpc.intercept_channel(self._grpc_channel, metric_interceptor)
+
+        # Reset the _stubs (wrapped messages) and then wrap. If we don't, our iterceptor won't be used
+        self._stubs = {}
+        self._prep_wrapped_messages(client_info)
