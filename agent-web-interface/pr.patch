+def safe_attrgetter(attr_path: str, default=None):
+    """
+    Provides a safe way to get attributes using attrgetter with nested paths, returning None if any attribute is not found.
+
+    Args:
+        attr_path (str): The attribute path to retrieve, using dot notation (e.g., "config.config.job_type").
+        default: The default value to return if the attribute is not found.
+
+    Returns:
+        function: A function that safely retrieves the attribute from an object.
+    """
+    attrs = attr_path.split(".")
+    return lambda obj: reduce(lambda o, a: getattr(o, a, default) if o else default, attrs, obj)
diff --git a/src/seomax/utils/grpc.py b/src/seomax/utils/grpc.py
new file mode 100644
index 00000000..070b3903
--- /dev/null
+++ b/src/seomax/utils/grpc.py
@@ -0,0 +1,156 @@
+import datetime
+import json
+import pickle
+from typing import Any, Dict, List, TYPE_CHECKING
+
+from seomax.models.database import Job
+from seomax.cloud_logging.setup import logger
+
+
+import google.protobuf.message
+import grpc  # type: ignore
+import proto  # type: ignore
+from google.protobuf.json_format import MessageToJson
+
+if TYPE_CHECKING:
+    from grpc import _CallFuture
+
+
+def convert_inner_grpc_write_value(field_mapping: Dict) -> Any:
+    """
+    Convert grpc payload inner values to pydantic dict.
+
+    Args:
+        field_mapping: Dictionary mapping field types to values
+
+    Returns:
+        Converted value with proper type handling
+    """
+    field_types: List[str] = list(field_mapping.keys())
+    if not field_types:
+        return None
+    field_type = field_types[0]
+    value = field_mapping[field_type]
+    if field_type == "mapValue":
+        return {k: convert_inner_grpc_write_value(v) for k, v in value.get("fields", {}).items()}
+    elif field_type == "arrayValue":
+        return [convert_inner_grpc_write_value(v) for v in value.get("values", [])]
+    elif field_type == "nullValue":
+        return None
+    elif field_type == "timestampValue":
+        try:
+            return datetime.datetime.fromisoformat(value)
+        except ValueError:
+            # Handle the case where the string does not match ISO format exactly
+            if "Z" in value:
+                value = value.replace("Z", "+00:00")  # Replace 'Z' with '+00:00' to indicate UTC
+            return datetime.datetime.strptime(value, "%Y-%m-%dT%H:%M:%S.%f%z")
+    elif field_type == "integerValue":
+        return int(value)
+    else:
+        return str(value)
+
+
+def extract_job_from_grpc_write(job_write_doc: Dict[str, Any]) -> Job:
+    """
+    Extract Job model instance from Firestore grpc write response.
+
+    Args:
+        job_write_doc: Dictionary containing job data that was written
+
+    Returns:
+        Job model instance
+    """
+    intermediary_dict = {}
+
+    for field_name, field_mapping in job_write_doc.get("fields", {}).items():
+        intermediary_dict[field_name] = convert_inner_grpc_write_value(field_mapping)
+    return Job(**intermediary_dict)
+
+
+def parse_grpc_job_writes(response_payload: str) -> List[Job]:
+    """
+    Parse job document updates from Firestore grpc response payload.
+
+    Args:
+        response_payload (str): JSON string containing write operations
+
+    Returns:
+        List of parsed Job instances
+    """
+    jobs = []
+    payload_json: Dict = json.loads(response_payload)
+    for write in payload_json.get("writes", []):
+        for write_op, write_data in write.items():
+            # Guards
+            doc_name: str = write_data.get("name", None)
+            if not doc_name:
+                continue
+            logger.debug(f"Found {write_op=} for `{doc_name}`")
+
+            if doc_name.split("/")[-2] != "JOBS":
+                continue
+
+            doc_fields = write_data.get("fields", dict())
+            if "id" not in doc_fields:
+                continue
+
+            # Parse
+            logger.info(f"Parsing {doc_name} as Job...")
+            job = extract_job_from_grpc_write(doc_fields)
+            logger.info(
+                f"Successfully parsed {doc_name} as Job {job}",
+                extra={"input": write_data, "parsed": job.model_dump()},
+            )
+            jobs.append(job)
+
+
+def extract_grpc_response_payload(client_call_details: grpc.ClientCallDetails, response: "_CallFuture") -> str:
+    response_metadata = response.trailing_metadata()
+    # Convert gRPC metadata `<class 'grpc.aio._metadata.Metadata'>` to list of tuples
+    metadata = dict([(k, str(v)) for k, v in response_metadata]) if response_metadata else None
+    result = response.result()
+    if isinstance(result, proto.Message):
+        response_payload = type(result).to_json(result)
+    elif isinstance(result, google.protobuf.message.Message):
+        response_payload = MessageToJson(result)
+    else:
+        response_payload = f"{type(result).__name__}: {pickle.dumps(result)}"
+    grpc_response = {
+        "payload": response_payload,
+        "metadata": metadata,
+        "status": "OK",  # TODO replace this with actual status?
+    }
+    extra = {
+        "serviceName": "google.firestore.v1.Firestore",
+        "rpcName": str(client_call_details.method),
+        "response": grpc_response,
+        "metadata": grpc_response["metadata"],
+    }
+    logger.debug(f"Received response for {client_call_details.method}. {extra}", extra=extra)
+
+    return response_payload
+
+
+def log_grpc_request(client_call_details: grpc.ClientCallDetails, request_or_iterator: Any):
+    request_metadata = client_call_details.metadata
+    request_metadata = {key: value.decode("utf-8") if isinstance(value, bytes) else value for key, value in request_metadata}
+    if isinstance(request_or_iterator, proto.Message):
+        request_payload = type(request_or_iterator).to_json(request_or_iterator)
+    elif isinstance(request_or_iterator, google.protobuf.message.Message):
+        request_payload = MessageToJson(request_or_iterator)
+    else:
+        request_payload = f"{type(request_or_iterator).__name__}"
+
+    grpc_request = {
+        "payload": request_payload,
+        "requestMethod": "grpc",
+        "metadata": dict(request_metadata),
+    }
+    extra = {
+        "serviceName": "google.firestore.v1.Firestore",
+        "rpcName": str(client_call_details.method),
+        "request": grpc_request,
+        "metadata": grpc_request["metadata"],
+    }
+    logger.debug(f"Sending request for {client_call_details.method}. {extra}", extra=extra)
