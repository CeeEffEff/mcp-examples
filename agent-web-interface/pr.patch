+
+B = TypeVar("B", bound=bool)
+
+
+class EnvBooleanVar(EnvVar[B]):
+    def __init__(
+        self,
+        name: str,
+        true_vals: Set[str] = None,
+        false_vals: Set[str] = None,
+        required: bool = True,
+        default: Optional[bool] = None,
+    ):
+        super().__init__(
+            name=name,
+            required=required,
+            default=default,
+        )
+        if true_vals is None:
+            true_vals = {"true", "t", "1", "y", "yes"}
+        self.true_vals = true_vals
+        if false_vals is None:
+            false_vals = {"false", "f", "0", "n", "no"}
+        self.false_vals = false_vals
+
+    @cached_property
+    def value(self) -> B:
+        _val: str = super().value
+        _val = _val.lower()
+        if _val in self.true_vals:
+            return True
+        if _val in self.false_vals:
+            return False
+        raise ValueError(f"{_val} is not a valid True/False value ({self.true_vals}/{self.false_vals})")
diff --git a/src/seomax/implementations/metric_client_interceptor.py b/src/seomax/implementations/metric_client_interceptor.py
new file mode 100644
index 00000000..eb0e5e25
--- /dev/null
+++ b/src/seomax/implementations/metric_client_interceptor.py
@@ -0,0 +1,113 @@
+import json
+from functools import partial
+from typing import TYPE_CHECKING, Any, Callable
+
+from seomax.cloud_logging.setup import logger
+from seomax.implementations.job_metrics import JobMetricsUpdater
+from seomax.models.metrics import JobMetrics
+from seomax.utils import grpc as grpc_utils
+
+
+import grpc
+
+if TYPE_CHECKING:
+    from grpc import _CallFuture
+
+
+class MetricClientInterceptor(
+    grpc.UnaryUnaryClientInterceptor,
+    grpc.UnaryStreamClientInterceptor,
+    grpc.StreamUnaryClientInterceptor,
+    grpc.StreamStreamClientInterceptor,
+):
+    def __init__(self, metrics_updater: JobMetricsUpdater):
+        super().__init__()
+        self.metrics_updater = metrics_updater
+
+    def intercept_unary_unary(self, continuation, client_call_details, request):
+        return self.intercept_outgoing_unary(continuation, client_call_details, request)
+
+    def intercept_unary_stream(self, continuation, client_call_details, request):
+        return self.intercept_outgoing_unary(continuation, client_call_details, request)
+
+    def intercept_stream_unary(self, continuation, client_call_details, request_iterator):
+        return self.intercept_outgoing_stream(continuation, client_call_details, request_iterator)
+
+    def intercept_stream_stream(self, continuation, client_call_details, request_iterator):
+        return self.intercept_outgoing_stream(continuation, client_call_details, request_iterator)
+
+    def intercept_outgoing_unary(
+        self,
+        continuation: Callable[[grpc.ClientCallDetails, Any], "_CallFuture"],
+        client_call_details: grpc.ClientCallDetails,
+        request: Any,
+    ) -> "_CallFuture":
+        """
+        Intercept outgoing unary RPC calls.
+
+        Args:
+            continuation: Continuation function for the RPC call
+            client_call_details: Details about the RPC call
+            request: Request payload
+        """
+        grpc_utils.log_grpc_request(client_call_details=client_call_details, request_or_iterator=request)
+        response = continuation(client_call_details, request)
+        response.add_done_callback(partial(self.handle_grpc_response, client_call_details))
+        return response
+
+    def intercept_outgoing_stream(
+        self,
+        continuation: Callable[[grpc.ClientCallDetails, Any], "_CallFuture"],
+        client_call_details: grpc.ClientCallDetails,
+        request_iterator: Any,
+    ) -> "_CallFuture":
+        """
+        Intercept outgoing stream RPC calls.
+
+        Args:
+            continuation: Continuation function for the RPC call
+            client_call_details: Details about the RPC call
+            request_iterator: Iterator for request data in stream
+        """
+        grpc_utils.log_grpc_request(
+            client_call_details=client_call_details,
+            request_or_iterator=request_iterator,
+        )
+        response = continuation(client_call_details, request_iterator)
+        response.add_done_callback(partial(self.handle_grpc_response, client_call_details))
+        return response
+
+    def handle_grpc_response(self, client_call_details: grpc.ClientCallDetails, response: "_CallFuture"):
+        """
+        Process gRPC response and update job metrics.
+
+        Args:
+            client_call_details: Details about the RPC call
+            response: gRPC response object
+        """
+        response_payload = grpc_utils.extract_grpc_response_payload(client_call_details, response)
+
+        # Extract the document update
+        try:
+            jobs = grpc_utils.parse_grpc_job_writes(response_payload)
+        except json.JSONDecodeError:
+            logger.warning("Couldn't parse response_payload as json.", exc_info=True)
+            return
+        except Exception:
+            logger.warning("Unkown exception during parse of response_payload.", exc_info=True)
+            return
+
+        # Push metrics
+        for job in jobs:
+            if not job.status_current.status.is_in_terminal_state:
+                continue
+            logger.info(f"Pushing finalised metrics for {job.job_id}...", extra=job.model_dump())
+            try:
+                self.metrics_updater.patch_job_metrics(job_metrics=JobMetrics.from_job(job=job))
+            except Exception:
+                logger.exception(
+                    f"Unknown exception while patching metrics for {job.job_id}",
+                    extra=job.model_dump(),
+                )
+                continue
+            logger.info(f"Pushed finalised metrics for {job.job_id}.", extra=job.model_dump())
